# shell-integration-features = no-cursor, sudo, title, ssh-env, ssh-terminfo
# theme = light:Apple System Colors Light, dark:Apple System Colors
# theme = light:Catppuccin Latte, dark:Catppuccin Macchiato
# theme = light:Monokai Pro Light, dark:Monokai Pro
auto-update = check
auto-update-channel = stable
copy-on-select = clipboard
cursor-style = block
cursor-style-blink = false
custom-shader-animation = false
font-family = SF Mono Terminal
font-feature = -calt, -lig, -dlig
font-size = 18
link-url = true
macos-auto-secure-input = true
macos-option-as-alt = true
macos-shortcuts = deny
macos-titlebar-proxy-icon = hidden
macos-window-shadow = false
macos-window-shadow = true
maximize = true
mouse-hide-while-typing = true
quick-terminal-position = center
right-click-action = ignore
shell-integration-features = no-cursor, sudo, title
# theme = Builtin Pastel Dark
theme = Nord
window-colorspace = display-p3
window-inherit-working-directory = true
window-padding-balance = true
window-padding-x = 0
window-padding-y = 0
window-theme = system
window-title-font-family = SF Mono Terminal
